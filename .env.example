# Local author identity; export these values in your shell. Never commit .env.
CHASSIS_AGENT_ID=chief-of-staff
# Generate with chassis agent-token create. Export the one-time result; keep it out of files/logs.
CHASSIS_AGENT_TOKEN=
# Byte cap for a single MCP request (default 1 MiB).
CHASSIS_MCP_MAX_REQUEST_BYTES=1048576
# Portal uses this policy agent with CHASSIS_AGENT_TOKEN, not a request-supplied viewer.
CHASSIS_PORTAL_VIEWER_AGENT=reviewer
# Local sample execution only. Non-loopback bind is refused unless explicitly 1.
CHASSIS_PORTAL_ALLOW_REMOTE=0
CHASSIS_AGENT_NAME=Chassis Chief of Staff
CHASSIS_AGENT_EMAIL=chief-of-staff@chassis.local
# Optional server vault path; --vault overrides it. The server does not load .env.
CHASSIS_VAULT=
CHASSIS_HUMAN_NAME=
CHASSIS_HUMAN_EMAIL=
# Scratch board only. Token scopes: boards:read and boards:write.
MIRO_ACCESS_TOKEN=
MIRO_BOARD_ID=
