# Local author identity; export these values in your shell. Never commit .env.
CHASSIS_AGENT_ID=chief-of-staff
CHASSIS_AGENT_NAME=Chassis Chief of Staff
CHASSIS_AGENT_EMAIL=chief-of-staff@chassis.local
# Optional server vault path; --vault overrides it. The server does not load .env.
CHASSIS_VAULT=
CHASSIS_HUMAN_NAME=
CHASSIS_HUMAN_EMAIL=
# Scratch board only. Token scopes: boards:read and boards:write.
MIRO_ACCESS_TOKEN=
MIRO_BOARD_ID=
