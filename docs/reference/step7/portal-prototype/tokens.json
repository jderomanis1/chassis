{
  "$description": "Chassis portal design tokens. themes.dark and themes.light map onto the same CSS custom property names in index.html. Contrast computed by tools/contrast.py (WCAG 2.x).",
  "font": {
    "display": {
      "value": "Chakra Petch",
      "weights": [
        500,
        600,
        700
      ],
      "use": "headings, big numbers"
    },
    "body": {
      "value": "IBM Plex Sans",
      "weights": [
        400,
        500,
        600
      ]
    },
    "mono": {
      "value": "JetBrains Mono",
      "weights": [
        400,
        500
      ],
      "use": "micro-labels, ids"
    }
  },
  "font-size": {
    "micro": "11px",
    "sm": "13px",
    "body": "15px",
    "lg": "18px",
    "xl": "24px",
    "num": "44px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "pill": "999px"
  },
  "elevation": {
    "1": "0 1px 0 rgba(255,255,255,.04) inset, 0 8px 24px rgba(0,0,0,.35)",
    "2": "0 1px 0 rgba(255,255,255,.05) inset, 0 18px 48px rgba(0,0,0,.55)"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "fast": "140ms",
    "base": "260ms",
    "slow": "520ms",
    "reduced-motion": "all animation and transitions off under prefers-reduced-motion or ?static"
  },
